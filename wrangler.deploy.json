{
    "name":  "amz-pilot-ops",
    "main":  "dist/server/index.js",
    "compatibility_date":  "2026-07-28",
    "compatibility_flags":  [
                                "nodejs_compat"
                            ],
    "vars":  {
                 "ADS_AGENT_VERSION":  "v2"
             },
    "observability":  {
                            "enabled":  true
                        },
    "assets":  {
                   "directory":  "dist/client"
               },
    "d1_databases":  [
                         {
                             "binding":  "DB",
                             "database_name":  "amz-pilot-ops",
                             "database_id":  "e3ea5f58-883d-4d7d-a74a-a870f1dbb22d"
                         }
                     ],
    "r2_buckets":  [
                       {
                           "binding":  "FILES",
                           "bucket_name":  "amz-pilot-ops-files"
                       }
                   ],
    "workflows":  [
                       {
                           "binding":  "ENHANCED_ADS_WORKFLOW",
                           "name":  "amz-pilot-enhanced-ads",
                           "class_name":  "EnhancedAdsWorkflow"
                       }
                   ],
    "images":  {
                   "binding":  "IMAGES"
               },
    "triggers":  {
                     "crons":  [
                                   "0 0 */2 * *"
                               ]
                 },
    "containers":  [
                       {
                           "class_name":  "RankTrackerContainer",
                           "image":  "./cloudbase-proxy/Dockerfile.rank",
                           "max_instances":  1,
                           "instance_type":  "basic"
                       },
                       {
                           "class_name":  "EnhancedAdsContainer",
                           "image":  "./agentcore/ads-agent/Dockerfile",
                           "max_instances":  1,
                           "instance_type":  "basic"
                       }
                   ],
    "durable_objects":  {
                            "bindings":  [
                                             {
                                                 "name":  "RANK_CONTAINER",
                                                 "class_name":  "RankTrackerContainer"
                                             },
                                             {
                                                 "name":  "ADS_AGENT_STATE",
                                                 "class_name":  "AdsAgentState"
                                             },
                                             {
                                                 "name":  "ENHANCED_ADS_CONTAINER",
                                                 "class_name":  "EnhancedAdsContainer"
                                             }
                        ]
    },
    "exports":  {
                    "RankTrackerContainer":  {
                                                  "type":  "durable-object",
                                                  "storage":  "sqlite"
                                              },
                    "AdsAgentState":  {
                                           "type":  "durable-object",
                                           "storage":  "sqlite"
                                              },
                    "EnhancedAdsContainer":  {
                                                  "type":  "durable-object",
                                                  "storage":  "sqlite"
                                              }
                }
}
